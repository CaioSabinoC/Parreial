# --- Servidor ---
PORT=3000
CORS_ORIGIN=*            # em produção, coloque a URL do front (ex.: https://seu-site.netlify.app)

# --- MongoDB (local ou Atlas) ---
MONGODB_URI=mongodb://localhost:27017/parreiral

# --- ThingSpeak MQTT (Devices > MQTT no ThingSpeak) ---
MQTT_ENABLED=true
MQTT_HOST=mqtt3.thingspeak.com
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
THINGSPEAK_CHANNEL_ID=3493396
# MQTT_TOPIC=channels/3493396/subscribe   # só se precisar mudar o padrão

# --- Qual field do canal guarda cada sensor ---
FIELD_TEMPERATURA=1
FIELD_UMIDADE_AR=2
FIELD_UMIDADE_SOLO=3

# --- Calibração do sensor de solo (opcional) ---
# Se o ESP32 envia o valor BRUTO do ADC, informe a leitura com o sensor
# seco (no ar) e molhado (na água) para converter em %.
# SOLO_RAW_SECO=3000
# SOLO_RAW_MOLHADO=1200
