# --- Servidor ---
PORT=3000
CORS_ORIGIN=*            # em produção, coloque a URL do front (ex.: https://seu-site.netlify.app)

# --- MongoDB (local ou Atlas) ---
MONGODB_URI=mongodb://localhost:27017/parreiral

# --- ThingSpeak MQTT (Devices > MQTT no ThingSpeak) ---
MQTT_ENABLED=true
MQTT_HOST=mqtt3.thingspeak.com
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
THINGSPEAK_CHANNEL_ID=3493396
# MQTT_TOPIC=channels/3493396/subscribe   # só se precisar mudar o padrão

# --- Qual field do canal guarda cada sensor ---
FIELD_TEMPERATURA=1
FIELD_UMIDADE_AR=2
FIELD_UMIDADE_SOLO=3

# --- Calibração do sensor de solo (opcional) ---
# Se o ESP32 envia o valor BRUTO do ADC, informe a leitura com o sensor
# seco (no ar) e molhado (na água) para converter em %.
# SOLO_RAW_SECO=3000
# SOLO_RAW_MOLHADO=1200

# --- Segurança (obrigatório: a API não sobe sem estes 3) ---
CODIGO_MISSAO=         # 6 letras/números que o professor envia (use TESTE1 até chegar)
JWT_SECRET=            # texto longo e aleatório, mínimo 32 caracteres
OTP_CHAVE=             # 64 caracteres hexadecimais. Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OTP_JANELA=1         # passos de 30 s aceitos para cada lado do código (padrão 1)
# MAX_FALHAS=5         # erros seguidos antes de bloquear a conta
# BLOQUEIO_MIN=15      # minutos de bloqueio
# TOKEN_ACESSO_MIN=60  # validade do token depois do OTP
# MONGODB_URI_TESTE=   # banco SÓ para npm test (nome terminando em "teste"); se vazio usa parreiral_teste
